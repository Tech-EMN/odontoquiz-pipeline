# OdontoQuiz Pipeline
# Configuração de ambiente — copie para .env e preencha

# ─── App ────────────────────────────────────────────────────────────────────
APP_NAME=OdontoQuiz Pipeline
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui
SUPABASE_ANON_KEY=sua_anon_key_aqui
SUPABASE_STORAGE_BUCKET=materiais

# ─── OpenAI ──────────────────────────────────────────────────────────────────
# IMPORTANTE: A key deve ter 164 caracteres (project key sk-proj-...).
# Admin keys (sk-admin-...) podem expirar ou perder escopo de modelo.
OPENAI_API_KEY=sk-sua-key-aqui
OPENAI_MODEL=gpt-4o

# ─── OdontoQuiz API ──────────────────────────────────────────────────────────
ODONTOQUIZ_API_BASE_URL=https://www.odontoquiz.com.br/api/v1/quiz-ai
ODONTOQUIZ_API_KEY=sua_api_key_aqui

# ─── Webhook Token (MCP auth) ────────────────────────────────────────────────
# Mesmo token usado no frontend Lovable para autenticar as chamadas
WEBHOOK_TOKEN=

# ─── Celery + Redis (F2) ────────────────────────────────────────────────────
# Redis é necessário para processamento assíncrono
# Local: redis://localhost:6379/0
# Railway: configurado automaticamente via add-on Redis
REDIS_URL=redis://localhost:6379/0
# Opcional — se vazio, usa REDIS_URL para ambos
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

*** ─── Database (F3) ────────────────────────────────────────────────────────
# URL do connection pooler do Supabase para Alembic migrations
# Formato: postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=
